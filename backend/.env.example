APP_ENV=development

# Database configuration (local postgres or remote supabase)
NERAVU_DB_TARGET=supabase
POSTGRES_DB=neravu_dev
POSTGRES_USER=neravu
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql+psycopg://neravu:replace_with_local_password@localhost:5432/neravu_dev
REDIS_URL=redis://localhost:6379/0

# Supabase configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_DATABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_HOST=aws-0-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# Sarvam AI API
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v4-flash
VOICE_RATE_LIMIT_REQUESTS=20
VOICE_RATE_LIMIT_WINDOW_SECONDS=60
MAX_AUDIO_BYTES=8388608

# Optional local admin override in development (e.g. 1)
DEV_ADMIN_TOKEN=1

# Guest session secret (at least 32 chars for HMAC token signing)
GUEST_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Dify guidance proxy configuration
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_APP_TYPE=advanced-chat
DIFY_LANGUAGE_INPUT=language
