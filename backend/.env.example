DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=your_dify_app_api_key
DIFY_APP_TYPE=advanced-chat

# Public frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configure the same value in the server environment and use it to sign guest session tokens.
GUEST_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# Optional. Used to verify signed-in Supabase access tokens with Supabase Auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chatflow input name configured in Dify for the selected response language.
DIFY_LANGUAGE_INPUT=language
